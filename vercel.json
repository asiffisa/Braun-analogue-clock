{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run package",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
